# ============================================================
# Crevio (ACEMS) Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ============================================================

# ----- Vite (Frontend) -----
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=Crevio
VITE_APP_VERSION=1.0.0
VITE_CLERK_PUBLISHABLE_KEY=      # Required: Get from Clerk Dashboard → API Keys

# ----- Server -----
API_PORT=3000

# ----- Database (Required) -----
DATABASE_URL=                     # Required: Neon PostgreSQL connection string (postgresql://...)

# ----- Clerk Authentication (Required) -----
CLERK_PUBLISHABLE_KEY=            # Required: Get from Clerk Dashboard → API Keys
CLERK_SECRET_KEY=                 # Required: Get from Clerk Dashboard → API Keys
CLERK_ADMIN_EMAILS=               # Comma-separated list of admin emails (e.g. admin@example.com)

# ----- JWT Legacy Auth -----
JWT_SECRET=                       # Required: Random string for signing legacy auth tokens

# ----- OpenAI (Required for AI features) -----
OPENAI_API_KEY=                   # Required for AI Campaign Assistant. Get from platform.openai.com

# ----- Razorpay Payments (Required for payment features) -----
RAZORPAY_KEY_ID=                  # Required: Get from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_SECRET=              # Required: Get from Razorpay Dashboard → Settings → API Keys

# ----- LinkedIn OAuth 2.0 (Optional: for brand onboarding LinkedIn integration) -----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/onboarding/brand

# ----- Meta / Instagram Graph API (Optional: for creator Instagram verification) -----
META_GRAPH_TOKEN=                 # Meta Graph API token for Instagram business discovery

# ----- Cloudinary (Optional: for image/file hosting) -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
